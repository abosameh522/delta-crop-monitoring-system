# Copy to .env and fill in your own values. Never commit .env.
# Everything below is OPTIONAL for the default pipeline.

# The default imagery source is Earth Search (AWS), which needs no credentials:
#   https://earth-search.aws.element84.com/v1
# Sentinel-2 L2A COGs are read directly over HTTPS.

# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu/) — OPTIONAL fallback.
# Only needed if Earth Search is unavailable and we switch ingestion back to CDSE.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional: override data lake location (defaults to ./data)
# DELTA_CROPS_DATA_DIR=./data

# Open-Meteo is free and needs no API key.
